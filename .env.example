# Copy to .env.local and fill in. Never commit real values.
# Xaman developer console: https://apps.xaman.dev  (create app -> API key; add redirect URI as an allowed origin)
VITE_XAMAN_API_KEY=00000000-0000-0000-0000-000000000000
VITE_XAMAN_REDIRECT_URI=http://localhost:5173/
# Devnet only: issuer of a test IOU that stands in for RLUSD (RLUSD does not exist on devnet). Leave empty to keep devnet actions disabled.
VITE_DEVNET_TEST_ISSUER=
# Mainnet vault lending is hard-off in src/config.js (NETWORKS.mainnet.vaultLending = false); there is no env switch for it.
