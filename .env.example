# Copy to .env.local and fill in. Never commit real values.
# Xaman developer console: https://apps.xaman.dev  (create app -> API key; add redirect URI as an allowed origin)
VITE_XAMAN_API_KEY=00000000-0000-0000-0000-000000000000
VITE_XAMAN_REDIRECT_URI=http://localhost:5173/
# Devnet only: public address of the issuer of DUSD, a devnet TEST token that stands in for RLUSD (RLUSD does not exist on devnet).
# The currency code is fixed in src/config.js (DEVNET_TEST_CURRENCY = "DUSD" as 40-hex); it is never the RLUSD code.
# Production (Vercel) uses the devnet test issuer rHprdcgDE8VM5PgjPjKGMjZGWGh98V4CHp (set 2026-10-08; devnet may reset without warning).
# Leave empty to keep devnet actions disabled. An address only: never put a seed here.
VITE_DEVNET_TEST_ISSUER=
# Mainnet vault lending is hard-off in src/config.js (NETWORKS.mainnet.vaultLending = false); there is no env switch for it.
