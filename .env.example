# Copy to .env.local and fill in. Never commit real values.
# Xaman developer console: https://apps.xaman.dev  (create app -> API key; add redirect URI as an allowed origin)
VITE_XAMAN_API_KEY=00000000-0000-0000-0000-000000000000
VITE_XAMAN_REDIRECT_URI=http://localhost:5173/
# Feature flags (all OFF by default)
VITE_ENABLE_VAULT_LENDING=false     # XLS-65/66 txs. Only meaningful on devnet today.
VITE_ENABLE_MAINNET_SENDS=false     # Never true in this build.
